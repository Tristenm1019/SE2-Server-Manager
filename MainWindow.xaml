<Window x:Class="SE2ServerManager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SE2 // Dedicated Server Control" Width="1330" Height="860" MinWidth="1060" MinHeight="710" Background="#09131B" Foreground="#D7E8EE" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
<Window.Resources>
 <SolidColorBrush x:Key="Panel" Color="#101F2A"/>
 <SolidColorBrush x:Key="Line" Color="#264452"/>
 <SolidColorBrush x:Key="Accent" Color="#36CDF4"/>
 <Style TargetType="Button"><Setter Property="Background" Value="#18303E"/><Setter Property="Foreground" Value="#DFF8FF"/><Setter Property="BorderBrush" Value="#316077"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,7,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#22526B"/><Setter Property="BorderBrush" Value="#39CFF8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></Style.Triggers></Style>
 <Style TargetType="TextBox"><Setter Property="Background" Value="#091721"/><Setter Property="Foreground" Value="#DFEFF2"/><Setter Property="BorderBrush" Value="#36586A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,7"/><Setter Property="CaretBrush" Value="#38D9FC"/><Setter Property="FontSize" Value="13"/></Style>
 <Style TargetType="TextBlock" x:Key="Label"><Setter Property="Foreground" Value="#7C9EAF"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 <Style TargetType="Border" x:Key="Tile"><Setter Property="Background" Value="#10222D"/><Setter Property="BorderBrush" Value="#274554"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,12,0"/></Style>
</Window.Resources>
<DockPanel>
 <Border DockPanel.Dock="Top" Background="#0D202C" BorderBrush="#2F7188" BorderThickness="0,0,0,1" Padding="26,15">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="7" Height="44" Background="#38D7FF" Margin="0,0,17,0"/><StackPanel><TextBlock Text="SPACE ENGINEERS 2" FontSize="26" FontWeight="Bold" FontFamily="Bahnschrift SemiCondensed" Foreground="#F0FAFE"/><TextBlock Text="DEDICATED SERVER   /   OPERATIONS CONSOLE" Foreground="#69BFD9" FontSize="11" FontWeight="SemiBold"/></StackPanel></StackPanel>
   <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="DSPROTO 0.1  //  EXPERIMENTAL" Foreground="#72BDD2" HorizontalAlignment="Right" FontSize="11"/><TextBlock Text="TARGET BUILD 4.0.0.3155" Foreground="#BBCED6" FontSize="11" HorizontalAlignment="Right" Margin="0,5,0,0"/></StackPanel>
  </Grid>
 </Border>
 <Grid Margin="24,21,24,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid Grid.Row="0" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SERVER OVERVIEW" Foreground="#80B6C7" FontWeight="Bold" FontSize="11"/><TextBlock Text="HOST CONTROL" Foreground="#E8F5F9" FontWeight="Bold" FontSize="23" FontFamily="Bahnschrift SemiCondensed"/></StackPanel><StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center"><Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#E6A758" Margin="0,0,10,0"/><TextBlock x:Name="StatusText" Text="OFFLINE" Foreground="#E6A758" FontWeight="Bold" FontSize="14"/></StackPanel></Grid>
 <Grid Grid.Row="1" Margin="0,0,0,17"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Style="{StaticResource Tile}"><StackPanel><TextBlock Style="{StaticResource Label}" Text="SERVER UPTIME"/><TextBlock x:Name="UptimeText" Text="00:00:00" FontSize="27" FontFamily="Consolas" Foreground="#EDF8FC" Margin="0,11,0,0"/></StackPanel></Border>
  <Border Grid.Column="1" Style="{StaticResource Tile}"><StackPanel><TextBlock Style="{StaticResource Label}" Text="CPU UTILIZATION"/><TextBlock x:Name="CpuText" Text="—" FontSize="27" FontFamily="Consolas" Foreground="#EDF8FC" Margin="0,11,0,0"/></StackPanel></Border>
  <Border Grid.Column="2" Style="{StaticResource Tile}"><StackPanel><TextBlock Style="{StaticResource Label}" Text="MEMORY USED"/><TextBlock x:Name="RamText" Text="—" FontSize="27" FontFamily="Consolas" Foreground="#EDF8FC" Margin="0,11,0,0"/></StackPanel></Border>
  <Border Grid.Column="3" Style="{StaticResource Tile}" Margin="0"><StackPanel><TextBlock Style="{StaticResource Label}" Text="UDP ENDPOINT"/><TextBlock x:Name="EndpointText" Text="0.0.0.0:27015" FontSize="21" FontFamily="Consolas" Foreground="#EDF8FC" Margin="0,14,0,0"/></StackPanel></Border>
 </Grid>
 <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#0A1822" BorderBrush="#285369" BorderThickness="1" Margin="0,0,17,0"><DockPanel>
   <Grid DockPanel.Dock="Top" Background="#143040" Height="48"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="17,0"><TextBlock Text="◆ " Foreground="#32CEF6"/><TextBlock Text="LIVE SERVER LOG" FontWeight="Bold" FontSize="12"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"><CheckBox x:Name="AutoScrollCheck" Content="Auto-scroll" IsChecked="True" Foreground="#9EC0CA" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Content="CLEAR VIEW" Click="ClearLog_Click" Padding="10,5"/></StackPanel></Grid>
   <Grid DockPanel.Dock="Bottom" Background="#101F2B" Height="46"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="LogPathText" Text="Waiting for log file..." TextTrimming="CharacterEllipsis" Foreground="#769BAA" VerticalAlignment="Center" Margin="15,0" FontSize="11"/><Button Grid.Column="1" Content="OPEN LOG FOLDER ↗" Click="OpenLogFolder_Click" VerticalAlignment="Center" Margin="0,0,10,0" Padding="10,5"/></Grid>
   <RichTextBox x:Name="LogBox" Background="#08141C" Foreground="#BED4DC" BorderThickness="0" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Padding="12" IsDocumentEnabled="False"><FlowDocument PageWidth="2000"/></RichTextBox>
  </DockPanel></Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="SERVER ACTIONS" FontSize="12" FontWeight="Bold" Foreground="#83BDCF" Margin="0,0,0,12"/>
    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="StartButton" Grid.Column="0" Content="▶  START LAST" Background="#145069" Click="StartLast_Click"/><Button Grid.Column="1" Content="＋  NEW WORLD" Click="CreateWorld_Click" Margin="0"/></Grid>
    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="◈  SAVE" Click="Save_Click"/><Button Grid.Column="1" Content="■  STOP" Click="Stop_Click" Margin="0"/></Grid>
    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="↻  RESTART" Click="Restart_Click"/><Button Grid.Column="1" Content="◎  STATUS" Click="Status_Click" Margin="0"/></Grid>
    <Button Content="⚠  FORCE QUIT (NO SAVE)" Background="#43282C" BorderBrush="#885060" Click="Quit_Click" Margin="0,0,0,20"/>
    <TextBlock Text="CONFIGURATION" FontSize="12" FontWeight="Bold" Foreground="#83BDCF" Margin="0,0,0,10"/>
    <TextBlock Style="{StaticResource Label}" Text="GAME INSTALL DIRECTORY" Margin="0,0,0,5"/><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="GamePathBox"/><Button Grid.Column="1" Content="..." Click="BrowseGame_Click" Margin="7,0,0,0"/></Grid>
    <TextBlock Style="{StaticResource Label}" Text="KIT DIRECTORY (NO SPACES)" Margin="0,0,0,5"/><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="KitPathBox"/><Button Grid.Column="1" Content="..." Click="BrowseKit_Click" Margin="7,0,0,0"/></Grid>
    <TextBlock Style="{StaticResource Label}" Text="SERVER NAME" Margin="0,0,0,5"/><TextBox x:Name="ServerNameBox" Margin="0,0,0,12" Text="SE2MP_Server"/>
    <TextBlock Style="{StaticResource Label}" Text="UDP PORT" Margin="0,0,0,5"/><TextBox x:Name="PortBox" Margin="0,0,0,12" Text="27015"/>
    <Button Content="APPLY SETTINGS" Click="SaveSettings_Click" Background="#16526A" Margin="0,0,0,9"/>
    <Button Content="CHECK WINDOWS FIREWALL" Click="Firewall_Click" Margin="0,0,0,10"/>
    <TextBlock Text="PROTOTYPE: No password, no player limit, and no SE2MP fixes. Only use with SE2 build 4.0.0.3155." Foreground="#A8A6A0" TextWrapping="Wrap" FontSize="11" LineHeight="17"/>
  </StackPanel></ScrollViewer>
 </Grid>
 <Grid Grid.Row="3" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="FooterText" Foreground="#79A2B0" Text="SYSTEM READY  //  CONFIGURE THE GAME PATH TO BEGIN" FontFamily="Consolas" FontSize="11"/><TextBlock Grid.Column="1" Text="HOST // CONTROL CENTER // V0.1" Foreground="#547D8D" FontSize="11"/></Grid>
 </Grid>
</DockPanel></Window>